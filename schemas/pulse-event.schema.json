{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kollabor8.net.au/schemas/pulse-event.schema.json",
  "title": "K8 Pulse Event",
  "type": "object",
  "required": [
    "event_id",
    "event_name",
    "version",
    "organisation_id",
    "occurred_at",
    "received_at",
    "source",
    "actor",
    "subject",
    "correlation_id",
    "payload",
    "sensitivity",
    "retention_class",
    "idempotency_key"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "organisation_id": {
      "type": "string",
      "minLength": 1
    },
    "client_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object"
    },
    "actor": {
      "type": "object"
    },
    "subject": {
      "type": "object"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment": {
      "enum": [
        "development",
        "test",
        "staging",
        "production"
      ]
    },
    "payload": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "retention_class": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "service_context": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "party_type": {
          "enum": [
            "customer",
            "client",
            "internal",
            "partner",
            "courier",
            "unknown"
          ]
        },
        "party_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "request_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "request_reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "channel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "priority": {
          "enum": [
            "low",
            "normal",
            "high",
            "urgent"
          ]
        },
        "sla_due_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "workflow_status": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "client_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
