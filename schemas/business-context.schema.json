{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kollabor8.net.au/schemas/business-context.schema.json",
  "title": "K8 Business Context",
  "type": "object",
  "required": ["context_id","organisation_id","version","status","created_at","created_by","organisation","goals","authority_rules","kpis"],
  "properties": {
    "context_id": {"type":"string","minLength":1},
    "organisation_id": {"type":"string","minLength":1},
    "version": {"type":"integer","minimum":1},
    "status": {"enum":["draft","active","superseded"]},
    "valid_from": {"type":["string","null"],"format":"date-time"},
    "created_at": {"type":"string","format":"date-time"},
    "created_by": {"type":"string","minLength":1},
    "change_reason": {"type":["string","null"]},
    "source_refs": {"type":"array","items":{"type":"string"}},
    "organisation": {"type":"object"},
    "brand": {"type":"object"},
    "products_services": {"type":"array","items":{"type":"object"}},
    "ideal_customers": {"type":"array","items":{"type":"object"}},
    "offers": {"type":"array","items":{"type":"object"}},
    "business_model": {"type":"object"},
    "goals": {"type":"array","items":{"type":"object"}},
    "current_constraints": {"type":"array","items":{"type":"object"}},
    "competitors": {"type":"array","items":{"type":"object"}},
    "technology": {"type":"array","items":{"type":"object"}},
    "people": {"type":"array","items":{"type":"object"}},
    "channels": {"type":"array","items":{"type":"object"}},
    "sales_process": {"type":"object"},
    "delivery_process": {"type":"object"},
    "marketing_process": {"type":"object"},
    "tone_voice": {"type":"object"},
    "legal_privacy_constraints": {"type":"array","items":{"type":"object"}},
    "authority_rules": {"type":"array","items":{"type":"object"}},
    "kpis": {"type":"array","items":{"type":"object"}},
    "known_claims": {"type":"array","items":{"type":"object"}},
    "evidence": {"type":"array","items":{"type":"object"}},
    "active_projects": {"type":"array","items":{"type":"object"}},
    "terminology": {"type":"array","items":{"type":"object"}}
  },
  "additionalProperties": false
}