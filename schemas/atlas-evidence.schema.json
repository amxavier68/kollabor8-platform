{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://kollabor8.net.au/schemas/atlas-evidence.schema.json",
  "title":"Atlas Evidence Record",
  "type":"object",
  "required":["evidence_id","organisation_id","correlation_id","run_id","actor","action","result","created_at","environment","sensitivity","retention_class","integrity"],
  "properties":{
    "evidence_id":{"type":"string","minLength":1},
    "organisation_id":{"type":"string","minLength":1},
    "correlation_id":{"type":"string","minLength":1},
    "causation_id":{"type":["string","null"]},
    "event_id":{"type":["string","null"]},
    "work_item_id":{"type":["string","null"]},
    "run_id":{"type":"string","minLength":1},
    "actor":{"type":"object"},
    "seat_id":{"type":["string","null"]},
    "agent_id":{"type":["string","null"]},
    "skill_id":{"type":["string","null"]},
    "tool_id":{"type":["string","null"]},
    "policy_decision_id":{"type":["string","null"]},
    "approval_id":{"type":["string","null"]},
    "action":{"type":"string","minLength":1},
    "input_refs":{"type":"array","items":{"type":"string"}},
    "output_refs":{"type":"array","items":{"type":"string"}},
    "result":{"enum":["observed","recommended","approved","executed","validated","rejected","blocked","safe_stopped","failed_recoverable","failed_manual","rolled_back","completed"]},
    "validation":{"type":"object"},
    "failure":{"type":["object","null"]},
    "recovery":{"type":["object","null"]},
    "created_at":{"type":"string","format":"date-time"},
    "environment":{"enum":["development","test","staging","production"]},
    "sensitivity":{"enum":["public","internal","confidential","restricted"]},
    "retention_class":{"type":"string","minLength":1},
    "previous_evidence_id":{"type":["string","null"]},
    "integrity":{"type":"object","required":["content_hash"],"properties":{"content_hash":{"type":"string","minLength":16}},"additionalProperties":true}
  },
  "additionalProperties": false
}